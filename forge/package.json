{
  "name": "forge",
  "displayName": "Forge",
  "description": "AI-powered software engineering mentor",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "ForgeMentor",
      "properties": {
        "forgeMentor.backendUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "URL of the ForgeMentor backend"
        }
      }
    },
    "commands": [
      {
        "command": "forge.askMentor",
        "title": "Ask ForgeMentor"
      },
      {
        "command": "forge.askSelectedCode",
        "title": "Ask ForgeMentor About Selected Code"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus && editorHasSelection",
          "command": "forge.askSelectedCode"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "title": "ForgeMentor",
          "icon": "./resources/icons/forge-logo.svg",
          "id": "forgeMentor"
        }
      ]
    },
    "views": {
      "forgeMentor": [
        {
          "name": "Mentor",
          "id": "forgeMentor.chat",
          "type": "webview",
          "icon": "$(comment-discussion)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}